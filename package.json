{
  "name": "wisconsin-2024-election-mapper",
  "version": "1.0.0",
  "private": true,
  "description": "Static Wisconsin presidential results explorer with certified 2024 data, historical baselines, and statistical screening charts.",
  "dependencies": {
    "pdfjs-dist": "^5.6.205",
    "xlsx": "^0.18.5"
  },
  "scripts": {
    "build:data": "node scripts/build-data.mjs",
    "build:states": "py -3 scripts/build-state-data.py",
    "build:states:download": "py -3 scripts/build-state-data.py --download",
    "build:state:geometry": "py -3 scripts/build-state-data.py --geometry-only",
    "build:michigan": "py -3 scripts/build-state-data.py data/state-configs/mi.json",
    "build:minnesota": "py -3 scripts/build-state-data.py data/state-configs/mn.json",
    "discover:sources": "node scripts/discover-state-sources.mjs",
    "apply:discovery": "node scripts/apply-source-discovery.mjs",
    "apply:source-profile": "node scripts/apply-state-source-profile.mjs",
    "build:arizona:sources": "node scripts/build-arizona-source-manifest.mjs",
    "probe:arizona:sources": "node scripts/probe-arizona-county-sources.mjs",
    "bootstrap:state-sources": "node scripts/bootstrap-state-sources.mjs",
    "add:state": "node scripts/add-state-pipeline.mjs",
    "inspect:sources": "py -3 scripts/inspect-state-sources.py",
    "scaffold:state": "py -3 scripts/scaffold-state.py",
    "build:history": "node scripts/build-historical-data.mjs",
    "validate": "node scripts/validate-data.mjs",
    "validate:history": "py -3 scripts/validate-historical-baseline.py",
    "validate:state-config": "node scripts/validate-state-config.mjs",
    "validate:source-pipeline": "node scripts/validate-source-pipeline.mjs",
    "validate:ui": "node scripts/validate-ui-static.mjs"
  }
}
